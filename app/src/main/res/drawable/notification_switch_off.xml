<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="54dp" android:height="30dp" />
            <solid android:color="#657184" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#556B7C93" />
        </shape>
    </item>
    <item android:width="22dp" android:height="22dp" android:left="4dp" android:gravity="center_vertical|left">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
