<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/notificationFloatingIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Floating"
            android:src="@android:drawable/ic_menu_view"
            android:tint="#777777" />

        <TextView
            android:id="@+id/notificationFloatingLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Floating"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/notificationFloatingSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Toggle Floating"
            android:showText="false"
            android:thumbTint="#9B7BFF"
            android:trackTint="#889B7BFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="4dp"
        android:background="#22777777" />

    <LinearLayout
        android:id="@+id/notificationPauseRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/notificationPauseIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Pause or Resume"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#777777" />

        <TextView
            android:id="@+id/notificationPauseLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Pause"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="4dp"
        android:background="#22777777" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/notificationProjectionIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="MediaProjection"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#777777" />

        <TextView
            android:id="@+id/notificationProjectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="M.Proj"
            android:textColor="#202124"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/notificationProjectionSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Toggle MediaProjection"
            android:showText="false"
            android:thumbTint="#9B7BFF"
            android:trackTint="#889B7BFF" />
    </LinearLayout>
</LinearLayout>
