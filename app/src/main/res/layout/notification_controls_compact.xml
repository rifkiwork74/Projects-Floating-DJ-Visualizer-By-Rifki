<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <TextView
        android:id="@+id/notificationCompactSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Floating OFF · Start Visualizer · EQ OFF · M.Proj OFF"
        android:textColor="#202124"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notificationCompactStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="0dp"
        android:text="Visualizer audio sistem aktif"
        android:textColor="#62666B"
        android:textSize="10sp" />
</LinearLayout>
